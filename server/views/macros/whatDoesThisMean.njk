{#
  whatDoesThisMean macro — wraps the repeated govukDetails "What this means" pattern.

  Parameters:
    html (string, required):     The explanation content.
    trackingId (string, required): data-tracking-id attribute value.
    classes (string):            Extra classes to pass through to govukDetails.
#}
{% from "govuk/components/details/macro.njk" import govukDetails %}

{% macro whatDoesThisMean(params) %}
  {{ govukDetails({
    summaryText: "What this means",
    html: params.html,
    classes: params.classes,
    attributes: { "data-tracking-id": params.trackingId }
  }) }}
{% endmacro %}
