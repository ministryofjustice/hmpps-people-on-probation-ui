{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{{ govukHeader() }}

{# On /admin pages, a citizen app session cookie left over from unrelated
   testing/browsing in the same browser must not drive the nav - only a
   session this admin actually started via /admin/search (previewedByAdmin)
   should. Off /admin pages (adminUser unset) any citizen session counts, as
   before. #}
{% if user and (not adminUser or user.previewedByAdmin) %}
  {# When the chatbot is enabled, chat is the landing page: Home moves to /home
     and a "Chat" item is added below it. With the flag off the nav is unchanged
     (Home points at /, no Chat item). #}
  {% set citizenNav = [
    { href: "/home" if chatbotEnabled else "/", text: "Home", active: currentPage === "home" }
  ] %}
  {% if chatbotEnabled %}
    {% set citizenNav = citizenNav.concat([
      { href: "/chat", text: "Chat", active: currentPage === "chat" }
    ]) %}
  {% endif %}
  {% set citizenNav = citizenNav.concat([
    { href: "/appointments", text: "Appointments and activities", active: currentPage === "appointments" },
    { href: "/goals", text: "Goals", active: currentPage === "goals" },
    { href: "/requirements", text: "Order requirements", active: currentPage === "requirements" },
    { href: "/admin/sign-out" if user.previewedByAdmin else "/sign-out", text: "Sign out", active: false }
  ]) %}
  {{ govukServiceNavigation({
    serviceName: "Check your probation account",
    serviceUrl: "/",
    collapseNavigationOnMobile: true,
    navigation: citizenNav
  }) }}
{% elif adminUser %}
  {{ govukServiceNavigation({
    serviceName: "Check your probation account",
    serviceUrl: "/admin/search",
    navigation: [
      {
        href: "/admin/sign-out",
        text: "Sign out",
        active: false
      }
    ]
  }) }}
{% else %}
  {{ govukServiceNavigation({
    serviceName: "Check your probation account",
    serviceUrl: "/"
  }) }}
{% endif %}
