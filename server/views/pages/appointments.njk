{% extends "../partials/layout.njk" %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "moj/components/alert/macro.njk" import mojAlert %}
{% from "moj/components/sub-navigation/macro.njk" import mojSubNavigation %}
{% from "moj/components/pagination/macro.njk" import mojPagination %}

{% set pageTitle = "Appointments and activities – Check your probation account – GOV.UK" %}
{% set currentPage = "appointments" %}

{% block content %}

  <h1 class="govuk-heading-xl">Appointments and activities</h1>

  <div class="govuk-!-margin-top-6">

    {% if missedAppointmentsCount > 1 %}
      {{ mojAlert({
        variant: "error",
        title: missedAppointmentsCount + " missed mandatory appointments or activities",
        showTitleAsHeading: true,
        dismissible: true,
        html: '<p class="govuk-body govuk-!-margin-bottom-0">Contact <a class="govuk-link govuk-link--no-visited-state" href="/probation-officer">your probation officer</a> as soon as possible to explain why you missed these appointments or activities.</p>'
      }) }}
    {% elif missedAlert %}
      {% set missedAlertHtml %}
        <p class="govuk-body govuk-!-margin-bottom-0">
          {{ missedAlert.date }}{% if missedAlert.timeRange %}, {{ missedAlert.timeRange }}{% endif %}.
        </p>
        <p class="govuk-body">
          ‘{{ missedAlert.type }}’{% if missedAlert.practitionerName %} with {{ missedAlert.practitionerName }}{% endif %}.
        </p>
        <p class="govuk-body govuk-!-margin-bottom-0">
          Contact <a class="govuk-link govuk-link--no-visited-state" href="/probation-officer">your probation officer</a> as soon as possible to explain why you missed this appointment or activity.
        </p>
      {% endset %}

      {{ mojAlert({
        variant: "error",
        title: "Missed mandatory appointment or activity",
        showTitleAsHeading: true,
        dismissible: true,
        html: missedAlertHtml
      }) }}
    {% endif %}

    <p class="govuk-body">
      Appointments and activities are a major part of your probation order. If you
      have problems attending,
      <a class="govuk-link govuk-link--no-visited-state" href="/probation-officer">let your probation officer know as soon as possible</a>.
    </p>

    {{ mojSubNavigation({
      label: "Appointment tabs",
      items: [
        { text: "Upcoming", href: "/appointments?tab=upcoming", active: tab !== "past" },
        { text: "Past", href: "/appointments?tab=past", active: tab === "past" }
      ]
    }) }}

    <h2 class="govuk-heading-l">{{ "Past appointments and activities" if tab === "past" else "Upcoming appointments and activities" }}</h2>

    {% set whyDetailsHtml %}
      <ul class="govuk-list govuk-list--bullet">
        <li>This list might not be up to date yet.{% if lastUpdatedAt %} Last update: {{ lastUpdatedAt }}{% endif %}</li>
        {% if hasTagAppointments %}
          <li>Tag appointments are sent by the electronic monitoring service</li>
        {% endif %}
        {% if hasOtherChannelAppointments %}
          <li>Appointments outside the Probation Service are sent through other channels</li>
        {% endif %}
      </ul>
    {% endset %}

    {% call govukInsetText({ classes: "guidance-panel" }) %}
      {% if hasTagAppointments or hasOtherChannelAppointments %}
        <p class="govuk-body govuk-!-margin-bottom-4">This list might not show all appointments and activities</p>
        {{ govukDetails({ summaryText: "Why this might happen", html: whyDetailsHtml, attributes: { "data-tracking-id": "appointments_why_list_may_not_be_up_to_date" } }) }}
      {% else %}
        <p class="govuk-body govuk-!-margin-bottom-0">This list might not be up to date yet.{% if lastUpdatedAt %} Last update: {{ lastUpdatedAt }}{% endif %}</p>
      {% endif %}
    {% endcall %}

    {% if appointments.length %}
      {% for appointment in appointments %}
        <div class="pop-summary-card">
          <div class="pop-summary-card__header">
            <span class="pop-summary-card__type">
              {{ appointment.type }}
            </span>
            {% if tab !== "past" %}
              <div class="pop-summary-card__actions">
                {% if appointment.address.length %}
                  <a class="govuk-link govuk-link--no-visited-state" href="{{ appointment.mapUrl }}" target="_blank" rel="noopener noreferrer" data-tracking-id="view_on_map">View on map<span class="govuk-visually-hidden"> (opens in new tab)</span></a>
                  <span class="pop-summary-card__separator" aria-hidden="true">|</span>
                {% endif %}
                {% if appointment.calendarUrl %}
                  <a class="govuk-link govuk-link--no-visited-state" href="{{ appointment.calendarUrl }}" data-tracking-id="add_to_calendar">Add to calendar</a>
                {% endif %}
              </div>
            {% endif %}
          </div>

          <dl class="pop-summary-card__details">
            <div class="pop-summary-card__row">
              <dt class="pop-summary-card__key">Date</dt>
              <dd class="pop-summary-card__value">{{ appointment.date or "" }}</dd>
            </div>
            {% if not appointment.isUnpaidWork and appointment.timeRange %}
              <div class="pop-summary-card__row">
                <dt class="pop-summary-card__key">Time</dt>
                <dd class="pop-summary-card__value">{{ appointment.timeRange }}</dd>
              </div>
            {% endif %}
            {% if not appointment.isUnpaidWork and appointment.address.length %}
              <div class="pop-summary-card__row">
                <dt class="pop-summary-card__key">Location</dt>
                <dd class="pop-summary-card__value">
                  {% for line in appointment.address %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
                </dd>
              </div>
            {% endif %}
            {% if not appointment.isUnpaidWork and appointment.pickUpAddress and appointment.pickUpAddress.length %}
              <div class="pop-summary-card__row">
                <dt class="pop-summary-card__key">Pick up and drop off address</dt>
                <dd class="pop-summary-card__value">
                  {% for line in appointment.pickUpAddress %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
                  {% if appointment.pickUpMapUrl %}
                    <div class="govuk-!-margin-top-1"><a href="{{ appointment.pickUpMapUrl }}" class="govuk-link" target="_blank" rel="noopener noreferrer" data-tracking-id="view_on_map">View on map<span class="govuk-visually-hidden"> (opens in new tab)</span></a></div>
                  {% endif %}
                </dd>
              </div>
            {% endif %}
            {% if not appointment.isUnpaidWork and appointment.workAddress and appointment.workAddress.length %}
              <div class="pop-summary-card__row">
                <dt class="pop-summary-card__key">Work address</dt>
                <dd class="pop-summary-card__value">
                  {% for line in appointment.workAddress %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
                  {% if appointment.workMapUrl %}
                    <div class="govuk-!-margin-top-1"><a href="{{ appointment.workMapUrl }}" class="govuk-link" target="_blank" rel="noopener noreferrer" data-tracking-id="view_on_map">View on map<span class="govuk-visually-hidden"> (opens in new tab)</span></a></div>
                  {% endif %}
                </dd>
              </div>
            {% endif %}
            {% if not appointment.isUnpaidWork and appointment.practitionerName %}
              <div class="pop-summary-card__row">
                <dt class="pop-summary-card__key">Key contact</dt>
                <dd class="pop-summary-card__value">{{ appointment.practitionerName }}</dd>
              </div>
            {% endif %}
            {% if tab === "past" and appointment.outcome %}
              <div class="pop-summary-card__row">
                <dt class="pop-summary-card__key">Status</dt>
                <dd class="pop-summary-card__value">
                  {{ govukTag({ text: appointment.outcome, classes: appointment.outcomeTagClasses }) }}
                </dd>
              </div>
            {% endif %}
          </dl>
        </div>
      {% endfor %}
    {% else %}
      <p class="govuk-body">{{ "You have no past appointments." if tab === "past" else "You have no upcoming appointments." }}</p>
    {% endif %}

    {% if pagination %}
      {{ mojPagination({
        items: pagination.items,
        previous: pagination.previous,
        next: pagination.next,
        results: {
          from: pagination.results.from,
          to: pagination.results.to,
          count: pagination.results.count,
          text: "results"
        },
        landmarkLabel: "Appointments pagination"
      }) }}
    {% endif %}

    <p class="pop-back-to-top govuk-!-margin-top-6">
      <a class="govuk-link govuk-link--no-visited-state pop-back-to-top__link" href="#main-content">
        <svg class="pop-back-to-top__icon" xmlns="http://www.w3.org/2000/svg" width="14.8683" height="19.1" viewBox="0 0 14.8683 19.1" fill="none" aria-hidden="true" focusable="false">
          <path d="M7.43413 0L0 7.43413L1.6012 9.1497L6.17605 4.57485V19.1H8.46347V4.57485L13.3814 9.1497L14.8683 7.31976L7.43413 0Z" fill="currentColor"/>
        </svg>
        Back to top
      </a>
    </p>

  </div>

{% endblock %}
