{% extends "../_guide.njk" %}

{% block guideContent %}
  <p class="govuk-body">If you would like to take part, <a class="govuk-link" href="[Link to go here]">use this link to book a time to talk to us</a>.</p>

  <p class="govuk-body">You can choose to get a text message to remind you about your call, the text message will come from 85040.</p>

  <h3 class="govuk-heading-s">Ways to ask questions or contact us about this research</h3>

  <p class="govuk-body">If you have any questions about this research or need help booking a time to talk to us, you can email us at <a class="govuk-link" href="mailto:probation-research@justice.gov.uk">probation-research@justice.gov.uk</a>.</p>

  <p class="govuk-body">You can also use this email to tell us if you:</p>

  <ul class="govuk-list govuk-list--bullet">
    <li>Do not want us to contact you about research.</li>
    <li>Have changed your mind and do not want to take part anymore.</li>
  </ul>

  <p class="govuk-body">[research team contact details and how to get in touch]</p>
{% endblock %}
