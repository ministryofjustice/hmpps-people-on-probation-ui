{% extends "../partials/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "partials/progress-bar.njk" import progressBar %}

{% set pageTitle = requirement.label + " – Check your probation account – GOV.UK" %}
{% set currentPage = "requirements" %}

{% block breadcrumb %}
  {{ govukBackLink({ text: "Back", href: "/requirements" }) }}
{% endblock %}

{% block content %}

  <span class="govuk-caption-l">Order requirements</span>
  <h1 class="govuk-heading-xl pop-requirement-detail__heading">{{ requirement.label }}</h1>

  {% if requirement.isGpsTag %}
    {% set gpsTagExplanationHtml %}
      <p class="govuk-body">A GPS tag is a location tag. It tracks where you go.</p>
      <p class="govuk-body">It can record your movements all the time. It checks if you stay out of banned areas, go to required appointments, and stick to any curfew.</p>
      <p class="govuk-body">You usually wear it on your ankle. You must charge a location tag for at least 1 hour every day. If you do not follow the tag rules, you could be returned to court or prison.</p>
    {% endset %}
    {{ govukDetails({
      summaryText: "What does this mean?",
      html: gpsTagExplanationHtml,
      attributes: { "data-tracking-id": "requirement_detail_gps_tag_what_does_this_mean" }
    }) }}
  {% elif requirement.isUnpaidWork %}
    {% set unpaidWorkExplanationHtml %}
      <p class="govuk-body">Community Payback is unpaid work in the community.</p>
      <p class="govuk-body">It can include jobs like removing graffiti or other useful local work. It is part of some community sentences. If you do not attend or take part, you could be returned to court.</p>
    {% endset %}
    {{ govukDetails({
      summaryText: "What does this mean?",
      html: unpaidWorkExplanationHtml,
      attributes: { "data-tracking-id": "requirement_detail_unpaid_work_what_does_this_mean" }
    }) }}
  {% elif requirement.isRAR %}
    {% set rarExplanationHtml %}
      <p class="govuk-body">RAR means Rehabilitation Activity Requirement.</p>
      <p class="govuk-body">It means you must take part in activities set by your probation officer to help reduce the chance of offending. This could include meetings, courses, or support work. If you do not take part, you could be returned to court.</p>
    {% endset %}
    {{ govukDetails({
      summaryText: "What does this mean?",
      html: rarExplanationHtml,
      attributes: { "data-tracking-id": "requirement_detail_rar_what_does_this_mean" }
    }) }}
  {% elif requirement.isCurfew %}
    {% set curfewExplanationHtml %}
      <p class="govuk-body">A curfew means you must stay at a set address during set hours.</p>
      <p class="govuk-body">It is often checked with an electronic tag. Your order or licence will say the address and times. If you do not follow it, you could be returned to court or recalled to prison.</p>
    {% endset %}
    {{ govukDetails({
      summaryText: "What does this mean?",
      html: curfewExplanationHtml,
      attributes: { "data-tracking-id": "requirement_detail_curfew_what_does_this_mean" }
    }) }}
  {% endif %}

  {% if requirement.lastUpdatedAt %}
    <div class="govuk-inset-text guidance-panel govuk-!-margin-bottom-6" id="requirement-last-updated">
      <p class="govuk-body govuk-!-margin-bottom-0">Your requirements were last updated on {{ requirement.lastUpdatedAt }}</p>
    </div>
  {% endif %}

  {% if requirement.isRAR %}
    <h2 class="govuk-heading-l pop-requirements__section-heading">Details</h2>

    <div class="pop-summary-card pop-summary-card--flat govuk-!-margin-bottom-9">
      <dl class="pop-summary-card__details">
        <div class="pop-summary-card__row">
          <dt class="pop-summary-card__key">Days completed</dt>
          <dd class="pop-summary-card__value">{{ requirement.completed }} {{ requirement.unitLabel }}</dd>
        </div>
        <div class="pop-summary-card__row">
          <dt class="pop-summary-card__key">Maximum days on order</dt>
          <dd class="pop-summary-card__value">{{ requirement.required }} {{ requirement.unitLabel }}</dd>
        </div>
      </dl>
    </div>
  {% else %}
    <h2 class="govuk-heading-l pop-requirements__section-heading">Progress and details</h2>

    <div class="pop-progress__row govuk-!-margin-bottom-4">
      {{ progressBar({
        percentComplete: requirement.percentComplete,
        completedDuration: requirement.completedDuration,
        remainingDuration: (requirement.remaining ~ " " ~ requirement.unitLabel) if requirement.remaining is defined else requirement.remainingDuration
      }) }}
    </div>

    <div class="pop-summary-card pop-summary-card--flat govuk-!-margin-bottom-9">
      <dl class="pop-summary-card__details">
        {% if requirement.required %}
          <div class="pop-summary-card__row">
            <dt class="pop-summary-card__key">Time required</dt>
            <dd class="pop-summary-card__value">{{ requirement.required }} {{ requirement.unitLabel }}</dd>
          </div>
        {% elif requirement.startDate %}
          <div class="pop-summary-card__row">
            <dt class="pop-summary-card__key">Start date and time</dt>
            <dd class="pop-summary-card__value">{{ requirement.startDate }}</dd>
          </div>
          <div class="pop-summary-card__row">
            <dt class="pop-summary-card__key">End date and time</dt>
            <dd class="pop-summary-card__value">{{ requirement.endDate }}</dd>
          </div>
          {% if requirement.totalLength %}
            <div class="pop-summary-card__row">
              <dt class="pop-summary-card__key">Time required</dt>
              <dd class="pop-summary-card__value">{{ requirement.totalLength }}</dd>
            </div>
          {% endif %}
          <div class="pop-summary-card__row">
            <dt class="pop-summary-card__key">Where to find details</dt>
            <dd class="pop-summary-card__value">You can find this information in your court order</dd>
          </div>
        {% endif %}
      </dl>
    </div>
  {% endif %}

  {% if requirement.isUnpaidWork %}
    <div class="govuk-inset-text guidance-panel">
      <p class="govuk-body govuk-!-margin-bottom-0">
        You can complete up to 30% of your community payback hours online through
        <a class="govuk-link govuk-link--no-visited-state" href="https://www.communitycampus.online/#/sign-in" target="_blank" rel="noopener noreferrer" data-tracking-id="community_campus_link">Community Campus<span class="govuk-visually-hidden"> (opens in new tab)</span></a>
      </p>
    </div>
  {% endif %}

{% endblock %}
