{% extends "../partials/layout.njk" %}

{% set pageTitle = "Your probation – Check your probation account – GOV.UK" %}
{% set currentPage = "requirements" %}

{% block content %}

  <h1 class="govuk-heading-xl">Your probation</h1>

  <p class="govuk-body">
    Make sure you follow the requirements included in your order. If you don’t, you could breach your probation, and go back to court.
  </p>
  {% if withLicence %}
    <p class="govuk-body">
      You also need to follow the licence conditions. If you do not, conditions could be added or made stricter. In some cases, you could go back to prison.
    </p>
  {% endif %}
  <p class="govuk-body">
    See also a summary of your <a class="govuk-link govuk-link--no-visited-state" href="/probation-agreement">probation agreement</a>.
  </p>

  {% if orders %}
    <h2 class="govuk-heading-l pop-requirements__section-heading">Summary</h2>
    {% if withLicence %}
      <p class="govuk-body">Your probation includes licence conditions and order requirements.</p>
    {% else %}
      <p class="govuk-body">You have {{ orderCount }} court orders.</p>
    {% endif %}
    <ol class="pop-order-summary govuk-!-margin-bottom-9">
      {% for order in orders %}
        <li class="pop-order-summary__item">
          <a class="govuk-link govuk-link--no-visited-state pop-order-summary__link" href="{{ order.href }}" data-tracking-id="requirements_order_{{ loop.index }}">{{ order.type }}</a>
          {% if order.endDate %}
            <p class="govuk-body pop-order-summary__date">End date: {{ order.endDate }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  {% else %}
    {% include "partials/order-progress-and-details.njk" %}
  {% endif %}

  {% if requirements.length %}
    <h2 class="govuk-heading-l pop-requirements__section-heading">Requirements in your {{ "orders" if orders else "order" }}</h2>

    <div class="pop-requirement-cards govuk-!-margin-bottom-9">
      {% for requirement in requirements %}
        <a class="pop-requirement-card" href="/your-probation/{{ requirement.slug }}" data-tracking-id="requirements_view_{{ requirement.slug }}">
          <span class="pop-requirement-card__title">{{ requirement.label }}</span>
        </a>
      {% endfor %}
    </div>
  {% endif %}

{% endblock %}
