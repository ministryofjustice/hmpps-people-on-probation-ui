{% extends "../partials/layout.njk" %}

{% set pageTitle = "Documents – Check your probation account – GOV.UK" %}
{% set currentPage = "documents" %}

{% block content %}

  <h1 class="govuk-heading-xl">Documents</h1>

  {% if documents.length %}
    <div class="pop-requirement-cards govuk-!-margin-bottom-9">
      {% for document in documents %}
        <a class="pop-requirement-card pop-requirement-card--chevron" href="/documents/{{ document.id }}" data-tracking-id="documents_view_{{ document.id }}">
          <span class="pop-requirement-card__title">{{ document.name }}</span>
          <span class="pop-requirement-card__chevron" aria-hidden="true">
            <svg viewBox="0 0 12 18" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M1 1l8 8-8 8" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p class="govuk-body">You do not have any documents yet.</p>
  {% endif %}

{% endblock %}
