{% extends "../partials/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "../macros/helpPanel.njk" import helpPanel %}

{% set pageTitle = group.title + " – Check your probation account – GOV.UK" %}
{% set currentPage = "licence" %}

{% block breadcrumb %}
  {{ govukBackLink({ text: "Back", href: "/licence/specific-conditions" }) }}
{% endblock %}

{% block content %}

  <span class="govuk-caption-l">Your licence conditions</span>
  <h1 class="govuk-heading-xl">{{ group.title }}</h1>

  <h2 class="govuk-heading-l">Your licence conditions</h2>
  {# Numbered as on the licence document, e.g. "7. (a)" - see toNumberedAdditionalConditions. Bespoke
     conditions have a number only. #}
  <ol class="govuk-list pop-condition-list">
    {% for condition in group.conditions %}
      <li class="pop-condition-list__item"><span class="pop-condition-list__number">{{ condition.number }}.</span><span>{% if condition.letter %}({{ condition.letter }}) {% endif %}{{ condition.text }}</span>
        {%- if condition.mapUrl %}
          {% set conditionLabel = condition.number + "." + (" (" + condition.letter + ")" if condition.letter else "") %}
          {# No extension: the browser adds one from the served content type. #}
          {% set mapFilename = "map-licence-condition-" + condition.number + (condition.letter or "") %}
          <div class="pop-condition-list__map">
            <h3 class="govuk-heading-s govuk-!-margin-bottom-2">{{ mapHeading }}</h3>
            <img class="pop-condition-map" src="{{ condition.mapUrl }}" alt="{{ mapHeading }} for licence condition {{ conditionLabel }}">
            <p class="govuk-body govuk-!-margin-bottom-0"><a class="govuk-link" href="{{ condition.mapUrl }}" download="{{ mapFilename }}" data-tracking-id="licence_condition_download_map">Download map<span class="govuk-visually-hidden"> for licence condition {{ conditionLabel }}</span></a></p>
          </div>
        {%- endif %}</li>
    {% endfor %}
  </ol>

  {% if nextDrugTest %}
    {% set appointment = nextDrugTest %}
    {% set cardTitle = "Next drug test" %}
    {% set locationLabel = "Address" %}
    {% set showActions = true %}
    {% include "../partials/appointment-card.njk" %}
  {% endif %}

  {% if helpTemplate %}
    {% set helpHtml %}{% include helpTemplate %}{% endset %}
    {{ helpPanel({ heading: "Help with this licence condition", html: helpHtml }) }}
  {% endif %}

{% endblock %}
