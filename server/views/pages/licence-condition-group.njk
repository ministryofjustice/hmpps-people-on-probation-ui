{% extends "../partials/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "../macros/helpPanel.njk" import helpPanel %}

{% set pageTitle = group.title + " – Check your probation account – GOV.UK" %}
{% set currentPage = "licence" %}

{% block breadcrumb %}
  {{ govukBackLink({ text: "Back", href: "/your-probation/specific-conditions" }) }}
{% endblock %}

{% block content %}

  <span class="govuk-caption-l">{{ "Your sentence and licence" if withOrders else "Your probation" }}</span>
  <h1 class="govuk-heading-xl">{{ group.title }}</h1>

  <h2 class="govuk-heading-l">{{ "Your licence condition" if group.conditions.length == 1 else "Your licence conditions" }}</h2>
  {# With two or more maps, each one is in its own collapsed "View map and description" section. #}
  {% set mapCount = group.conditions | selectattr("mapUrl") | length %}
  {# Numbered as on the licence document, e.g. "7. (a)" - see toNumberedAdditionalConditions. Bespoke
     conditions have a number only. The numbers are hidden unless features.licenceConditionNumbers is on;
     the maps are then labelled by the condition's position on this page instead. #}
  {% set showNumbers = features.licenceConditionNumbers %}
  {# Without numbers the order means nothing to the reader, so it's an unordered list, divided by the
     item borders. role="list" keeps Safari and VoiceOver announcing it as a list despite list-style: none. #}
  {% set listTag = "ol" if showNumbers else "ul" %}
  <{{ listTag }} class="govuk-list pop-condition-list" role="list">
    {% for condition in group.conditions %}
      <li class="pop-condition-list__item">
        {%- if showNumbers %}<span class="pop-condition-list__number">{{ condition.number }}.</span><span>{% if condition.letter %}({{ condition.letter }}) {% endif %}{{ condition.text }}</span>
        {%- else %}<span>{{ condition.text }}</span>{% endif %}
        {%- if condition.mapUrl %}
          {% if showNumbers %}
            {% set conditionLabel = condition.number + "." + (" (" + condition.letter + ")" if condition.letter else "") %}
            {% set conditionRef = condition.number + (condition.letter or "") %}
          {% else %}
            {% set conditionLabel = loop.index %}
            {% set conditionRef = loop.index %}
          {% endif %}
          {# No extension: the browser adds one from the served content type. #}
          {% set mapFilename = "map-licence-condition-" + conditionRef %}
          {# CVL's description of the mapped area goes with the map, above it, as in the design: the same for
             one map or several. One map isn't collapsed, so it also has the map's own heading. #}
          {% set mapHtml %}
            {% if condition.description %}
              <h3 class="govuk-heading-s govuk-!-margin-bottom-0">{{ mapHeadings.description }}</h3>
              <p class="govuk-body govuk-!-margin-bottom-3">{{ condition.description }}</p>
            {% endif %}
            {% if mapCount == 1 %}<h3 class="govuk-heading-s govuk-!-margin-bottom-2">{{ mapHeadings.map }}</h3>{% endif %}
            <img class="pop-condition-map" src="{{ condition.mapUrl }}" alt="{{ mapHeadings.map }} for licence condition {{ conditionLabel }}">
            <p class="govuk-body govuk-!-margin-bottom-0"><a class="govuk-link" href="{{ condition.mapUrl }}" download="{{ mapFilename }}" data-tracking-id="licence_condition_download_map">Download map<span class="govuk-visually-hidden"> for licence condition {{ conditionLabel }}</span></a></p>
          {% endset %}
          <div class="pop-condition-list__map">
            {% if mapCount > 1 %}
              {{ govukDetails({
                summaryHtml: 'View map and description<span class="govuk-visually-hidden"> for licence condition ' + conditionLabel + '</span>',
                html: mapHtml,
                classes: "govuk-!-margin-bottom-0",
                attributes: { "data-tracking-id": "licence_condition_view_map" }
              }) }}
            {% else %}
              {{ mapHtml | safe }}
            {% endif %}
          </div>
        {%- endif %}</li>
    {% endfor %}
  </{{ listTag }}>

  {% if approvedAddress %}
    <div class="pop-summary-card govuk-!-margin-bottom-6">
      <div class="pop-summary-card__header">
        <h2 class="pop-summary-card__type">Your approved address</h2>
      </div>
      <dl class="pop-summary-card__details">
        <div class="pop-summary-card__row">
          <dt class="pop-summary-card__key">Address</dt>
          <dd class="pop-summary-card__value">
            {% for line in approvedAddress %}
              {{ line }}{% if not loop.last %}<br>{% endif %}
            {% endfor %}
          </dd>
        </div>
      </dl>
    </div>
  {% endif %}

  {% if showAppointmentsLink %}
    <p class="govuk-body govuk-!-margin-bottom-6"><a class="govuk-link govuk-link--no-visited-state" href="/appointments" data-tracking-id="licence_condition_appointments_link">View your appointments and activities</a></p>
  {% endif %}

  {% if helpTemplate %}
    {% set helpHtml %}{% include helpTemplate %}{% endset %}
    {{ helpPanel({ heading: "Help with this licence condition", html: helpHtml }) }}
  {% endif %}

{% endblock %}
