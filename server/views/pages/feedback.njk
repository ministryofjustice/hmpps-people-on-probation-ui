{% extends "../partials/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% set pageTitle = "Feedback – Check your probation account – GOV.UK" %}
{% set currentPage = "feedback" %}

{% block breadcrumb %}
  {{ govukBackLink({ text: "Home", href: "/" }) }}
{% endblock %}

{% block content %}

  <h1 class="govuk-heading-l pop-feedback-heading">Give feedback about probation accounts</h1>

  <iframe
    id="pop-feedback-frame"
    class="pop-feedback-frame"
    src="https://www.smartsurvey.co.uk/t/78DZPT/"
    frameborder="0"
    title="Feedback survey"
    allowfullscreen
  ></iframe>

{% endblock %}
