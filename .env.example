NODE_ENV=development
PORT=3000
ENVIRONMENT_NAME=dev
NO_HTTPS=true

# GitHub Packages auth (install-time only, not read by the app itself).
# Required to install the private @justiceaiunit/chatbot-widget package.
# See README.md "Authenticate with GitHub Packages" for how to generate this.
NODE_AUTH_TOKEN=

# HMPPS Auth (system client credentials for API-to-API calls)
HMPPS_AUTH_URL=http://localhost:9090/auth
CLIENT_CREDS_CLIENT_ID=
CLIENT_CREDS_CLIENT_SECRET=
AUTH_CODE_CLIENT_ID=
AUTH_CODE_CLIENT_SECRET=

# Feature flags
# Admin "preview as user" feature (HMPPS Auth authorization-code grant).
# Enabled here for local testing against the docker-compose hmpps-auth
# container (HMPPS_AUTH_URL above) - depends on AUTH_CODE_CLIENT_ID/SECRET
# and CLIENT_CREDS_CLIENT_ID/SECRET being registered as clients there first.
# See README.md "Testing HMPPS Auth locally (admin preview)" for the steps.
# Security-sensitive in any real environment - set FEATURE_ADMIN_PREVIEW=false
# there unless a client has actually been provisioned against that tenant.
FEATURE_ADMIN_PREVIEW=true
FEATURE_MISSED_APPOINTMENT_ALERT=true
FEATURE_CHATBOT=true
FEATURE_ANALYTICS=true
FEEDBACK_BANNER_ENABLED=false

# Role-based gate (requireAdminRole) - HMPPS Auth roles allowed to use admin preview
ADMIN_AUTHORISED_ROLES=
# TEMPORARY alternative gate (requireAdminUsername) - see config.ts adminRestrictByUsername
ADMIN_RESTRICT_BY_USERNAME=true
ADMIN_AUTHORISED_USERNAMES=AUTH_ADM

# Downstream APIs
# PEOPLE_ON_PROBATION_API_URL=http://localhost:8080
PEOPLE_ON_PROBATION_API_URL=https://people-on-probation-api-dev.hmpps.service.justice.gov.uk
PEOPLE_ON_PROBATION_API_TIMEOUT_RESPONSE=5000
PEOPLE_ON_PROBATION_API_TIMEOUT_DEADLINE=5000

# Redis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS_ENABLED=false

# Session
SESSION_SECRET=local-dev-insecure-session-secret
WEB_SESSION_TIMEOUT_IN_MINUTES=30

# HMPPS Audit
AUDIT_ENABLED=false
AUDIT_SQS_REGION=eu-west-2
AUDIT_SQS_QUEUE_URL=http://localhost:4566/000000000000/mainQueue
AUDIT_SERVICE_NAME=hmpps-probation-accounts

# One Login (integration environment)
ONE_LOGIN_ISSUER_URL=https://oidc.integration.account.gov.uk
ONE_LOGIN_CLIENT_ID=
ONE_LOGIN_REDIRECT_URI=http://localhost:3000/sign-in/callback
ONE_LOGIN_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
ONE_LOGIN_SCOPES=email phone openid
ONE_LOGIN_VTR=Cl.Cm
ONE_LOGIN_KEY_ID=
ONE_LOGIN_PRIVATE_KEY_BASE64=
ONE_LOGIN_PUBLIC_KEY_BASE64=

# Local authentication bypass
# Keep this disabled unless you are running locally and want to skip GOV.UK One Login.
# When enabled, visit /local/sign-in to create a normal app session for the configured subject.
# The app still calls People on Probation API with LOCAL_AUTH_ONE_LOGIN_SUBJECT.
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_ONE_LOGIN_SUBJECT=
LOCAL_AUTH_EMAIL=local@example.com
LOCAL_AUTH_DISPLAY_NAME=Local User

# Chatbot
POP_CHATBOT_API_URL=
POP_CHATBOT_API_KEY=
POP_CHATBOT_USER_TOKEN_SECRET=

# Ingress
INGRESS_URL=http://localhost:3000
