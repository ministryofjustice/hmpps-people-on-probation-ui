NODE_ENV=development
PORT=3000
ENVIRONMENT_NAME=dev
NO_HTTPS=true

# HMPPS Auth (system client credentials for API-to-API calls)
HMPPS_AUTH_URL=https://sign-in-dev.hmpps.service.justice.gov.uk/auth
CLIENT_CREDS_CLIENT_ID=
CLIENT_CREDS_CLIENT_SECRET=

# Downstream APIs
PEOPLE_ON_PROBATION_API_URL=http://localhost:8080
PEOPLE_ON_PROBATION_API_TIMEOUT_RESPONSE=5000
PEOPLE_ON_PROBATION_API_TIMEOUT_DEADLINE=5000

# Redis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS_ENABLED=false

# Session
SESSION_SECRET=local-dev-insecure-session-secret

# One Login (integration environment)
ONE_LOGIN_ISSUER_URL=https://oidc.integration.account.gov.uk
ONE_LOGIN_CLIENT_ID=
ONE_LOGIN_REDIRECT_URI=http://localhost:3000/sign-in/callback
ONE_LOGIN_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
ONE_LOGIN_SCOPES=email phone openid
ONE_LOGIN_VTR=Cl.Cm
ONE_LOGIN_KEY_ID=
ONE_LOGIN_PRIVATE_KEY_BASE64=
ONE_LOGIN_PUBLIC_KEY_BASE64=

# Local authentication bypass
# Keep this disabled unless you are running locally and want to skip GOV.UK One Login.
# When enabled, visit /local/sign-in to create a normal app session for the configured subject.
# The app still calls People on Probation API with LOCAL_AUTH_ONE_LOGIN_SUBJECT.
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_ONE_LOGIN_SUBJECT=
LOCAL_AUTH_EMAIL=local@example.com
LOCAL_AUTH_DISPLAY_NAME=Local User

# Chatbot
POP_CHATBOT_API_URL=
POP_CHATBOT_API_KEY=

# Ingress
INGRESS_URL=http://localhost:3000
